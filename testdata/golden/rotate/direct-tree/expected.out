zfs rename -fp tank/target tank/target_base
zfs send -P -L -c -e tank/src@base
zfs recv -v -o readonly=on -u -x mountpoint -o canmount=noauto -s tank/target
zfs send -P -L -c -e -I tank/src@base tank/src@new
zfs recv -v -o readonly=on -u -x mountpoint -o canmount=noauto -s tank/target
zfs send -P -L -c -e tank/src/child@child
zfs recv -v -u -x mountpoint -o canmount=noauto -s tank/target/child
